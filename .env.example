# COSMOS Backend Configuration
PORT=5000
NODE_ENV=development

# Wikipedia / Wikimedia
WIKIMEDIA_API_URL=
# AI Provider — Google Gemini (Google AI Studio)
# Get your FREE API key from: https://aistudio.google.com/app/apikey
# Keys look like: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX
AI_API_URL=
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Future Live Satellite APIs
SATELLITE_API_URL=

# Earth FM Radio Directory API (Radio-Browser open directory, NO API key required)
RADIO_API_URL=https://de1.api.radio-browser.info

# NO CREDIT CARD NEEDED! COSMOS defaults to 100% FREE OpenStreetMap Nominatim.
# MAPBOX_ACCESS_TOKEN is completely optional. Leave blank for default free operation.
MAPBOX_ACCESS_TOKEN=
